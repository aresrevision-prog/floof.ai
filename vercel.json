{
  "functions": {
    "api/chat.js": {
      "maxDuration": 60
    },
    "api/image.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/functions/v1/:path*",
      "destination": "https://lakjmdyzuqrwcncxybcw.supabase.co/functions/v1/:path*"
    },
    {
      "source": "/rest/v1/rpc/:path*",
      "destination": "https://lakjmdyzuqrwcncxybcw.supabase.co/rest/v1/rpc/:path*"
    }
  ],
  "headers": [
    {
      "source": "/lex/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}